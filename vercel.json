{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.janeskin.cz" }], "destination": "https://janeskin.cz/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "janeskin.vercel.app" }], "destination": "https://janeskin.cz/:path*", "permanent": true },
    { "source": "/zasady-cookies-eu", "destination": "/gdpr", "permanent": true },
    { "source": "/zasady-cookies-eu/", "destination": "/gdpr", "permanent": true },
    { "source": "/janeskin-3", "destination": "/", "permanent": true },
    { "source": "/janeskin-3/", "destination": "/", "permanent": true },
    { "source": "/uncategorized/:path*", "destination": "/", "permanent": true },
    { "source": "/category/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/wp-sitemap-:rest", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-login.php", "destination": "/", "permanent": true }
  ]
}
