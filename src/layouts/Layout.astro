---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Kosmetický salon JANESKIN v Dolní Lutyni — profesionální kosmetická péče s kosmeceutikou Larens. Ošetření pleti, masáže, laminace řas a obočí, vizážistika. Jana Szymiková.',
  ogImage = '/images/salon/header-osetreni.jpg',
  noIndex = false,
} = Astro.props;

const site = Astro.site ?? 'https://janeskin.cz';
const canonicalURL = new URL(Astro.url.pathname, site);
const fullTitle = `${title} | JANESKIN`;
/* Facebook a spol. berou náhledový obrázek jen s plnou adresou */
const ogImageURL = new URL(ogImage, site);

/* Strukturovaná data pro Google: salon jako místní firma (adresa, telefon,
   poloha na mapě, profily). Hodnocení sem schválně nedáváme — Google
   u vlastních recenzí na webu firmy hvězdičky nezobrazuje a bere to jako spam. */
const businessData = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  '@id': 'https://janeskin.cz/#salon',
  name: 'JANESKIN – Salon Jana Szymiková',
  url: 'https://janeskin.cz/',
  image: new URL('/images/salon/kosmeticky-salon-janeskin-osetrovna.jpg', site).href,
  telephone: '+420724239998',
  email: 'jana.szymikova@seznam.cz',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'U Koupaliště 472',
    addressLocality: 'Dolní Lutyně',
    postalCode: '735 53',
    addressCountry: 'CZ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 49.8975914, longitude: 18.4247077 },
  founder: { '@type': 'Person', name: 'Jana Szymiková' },
  sameAs: [
    'https://www.instagram.com/salon_janaszymikova/',
    'https://www.facebook.com/profile.php?id=61569339962095',
    'https://www.firmy.cz/detail/13747453-janeskin-salon-jana-szymikova-dolni-lutyne.html',
  ],
};
---

<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:locale"      content="cs_CZ" />
  <meta property="og:site_name"   content="JANESKIN" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageURL} />

  {!noIndex && <script type="application/ld+json" set:html={JSON.stringify(businessData)} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Poppins:wght@200;300;400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Google Analytics G-1K66Z5KE38 — načte se AŽ po souhlasu v cookie liště
       (CookieConsent.astro). Bez souhlasu se skript od Googlu vůbec nestahuje.
       is:inline — Astro jinak skript zabalí do modulu a gtag() by nebyla globální. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    (function () {
      var GA_ID = 'G-1K66Z5KE38';
      window.janeskinLoadAnalytics = function () {
        if (window.janeskinAnalyticsLoaded) {
          gtag('consent', 'update', { analytics_storage: 'granted' });
          return;
        }
        window.janeskinAnalyticsLoaded = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', GA_ID);
      };
      try {
        if (localStorage.getItem('janeskin-cookies') === 'granted') window.janeskinLoadAnalytics();
      } catch (e) {}
    })();
  </script>
</head>

<body>
  <a href="#main-content" class="skip-link">Přeskočit na obsah</a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />
  <CookieConsent />
</body>
</html>

<script>
  // ── Scroll animace (IntersectionObserver) ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    {
      /* Práh musí být 0: vysoký prvek (např. rozbalená karta služby) se na
         malém displeji nikdy nezobrazí z 12 %, takže by zůstal neviditelný. */
      threshold: 0,
      rootMargin: '0px 0px -40px 0px',
    }
  );

  document.querySelectorAll('[data-animate]').forEach((el) => {
    observer.observe(el);
  });
</script>

<style is:global>
  /* Offset pro fixed header */
  html {
    scroll-padding-top: 80px;
  }

  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    background-color: var(--color-accent);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
