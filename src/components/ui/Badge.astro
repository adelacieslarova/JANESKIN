---
interface Props {
  text: string;
  variant?: 'gold' | 'subtle';
}

const { text, variant = 'gold' } = Astro.props;

/* Štítek je verzálkami, ale zkratka měny se píše vždy „Kč“ — z verzálek ji vyjmeme */
const parts = text.split(/(Kč)/);
---

<span class={`badge badge--${variant}`}><span>{parts.map(part => part === 'Kč' ? <span class="badge__currency">Kč</span> : part)}</span></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    white-space: nowrap;
    line-height: 1.4;
  }

  .badge__currency {
    text-transform: none;
  }

  .badge--gold {
    background-color: var(--color-accent-pale);
    color: var(--color-dark);
    border: 1px solid var(--color-accent-light);
  }

  .badge--subtle {
    background-color: var(--color-bg-alt);
    color: var(--color-text-soft);
    border: 1px solid var(--color-border);
  }
</style>
