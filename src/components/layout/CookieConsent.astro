---
/**
 * Lišta se souhlasem s analytickými cookies.
 *
 * Google Analytics se načítá až po kliknutí na „Přijmout“ (skript v <head> v Layout.astro,
 * funkce window.janeskinLoadAnalytics). Volba se pamatuje v localStorage pod klíčem
 * „janeskin-cookies“. Odmítnutí musí být stejně snadné jako přijetí — obě tlačítka
 * jsou proto stejně výrazná. Lištu lze znovu otevřít každým prvkem s [data-cookie-settings].
 */
---

<div class="cookie" id="cookie-consent" role="dialog" aria-live="polite" aria-labelledby="cookie-title" hidden>
  <p class="cookie__title" id="cookie-title">Souhlas s cookies</p>
  <p class="cookie__text">
    Se souhlasem používám analytické cookies Google Analytics, abych viděla, jak se web
    používá, a mohla ho zlepšovat. Bez souhlasu se nic neměří. Souhlas můžete kdykoli změnit
    v patičce webu. Více v&nbsp;<a href="/gdpr#cookies">zásadách zpracování osobních údajů</a>.
  </p>
  <div class="cookie__actions">
    <button type="button" class="cookie__btn" data-cookie-choice="denied">Odmítnout</button>
    <button type="button" class="cookie__btn" data-cookie-choice="granted">Přijmout</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-overlay);
    max-width: 520px;
    padding: var(--space-5) var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .cookie__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .cookie__text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-soft);
  }

  .cookie__text a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Obě volby stejně výrazné — odmítnutí nesmí být schované ani méně nápadné */
  .cookie__btn {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-dark);
    border-radius: var(--radius-full);
    background-color: var(--color-dark);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .cookie__btn:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .cookie__btn:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 2px;
  }
</style>

<script>
  const KEY = 'janeskin-cookies';
  const box = document.getElementById('cookie-consent');

  type Choice = 'granted' | 'denied';
  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as { gtag?: Gtag; janeskinLoadAnalytics?: () => void };

  function stored(): Choice | null {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'granted' || v === 'denied' ? v : null;
    } catch {
      return null;
    }
  }

  /** Smaže cookies Google Analytics (_ga, _ga_*) na doméně i nadřazených doménách. */
  function clearAnalyticsCookies() {
    const names = document.cookie.split(';').map(c => c.split('=')[0].trim()).filter(n => /^_ga/.test(n));
    const parts = location.hostname.split('.');
    const domains = [''];
    for (let i = 0; i < parts.length - 1; i++) domains.push('; domain=.' + parts.slice(i).join('.'));
    for (const name of names) {
      for (const d of domains) document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d}`;
    }
  }

  function choose(choice: Choice) {
    try { localStorage.setItem(KEY, choice); } catch { /* bez úložiště se jen zeptáme příště znovu */ }
    if (choice === 'granted') {
      w.janeskinLoadAnalytics?.();
    } else {
      w.gtag?.('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
    }
    if (box) box.hidden = true;
  }

  if (box) {
    if (!stored()) box.hidden = false;

    box.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach(btn => {
      btn.addEventListener('click', () => choose(btn.dataset.cookieChoice as Choice));
    });

    document.querySelectorAll('[data-cookie-settings]').forEach(el => {
      el.addEventListener('click', e => {
        e.preventDefault();
        box.hidden = false;
        box.querySelector<HTMLButtonElement>('[data-cookie-choice]')?.focus();
      });
    });
  }
</script>
