---
/**
 * Přehled kategorií služeb.
 *
 * Záměrně bez fotek — karty nesou jen zlatou ikonu, název, krátký popis
 * a cenu od. Fotky se na homepage soustředí do galerie, ať je přehled klidný.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { pricingData } from '../../data/pricing';

/* Poukazy mají vlastní sekci a doplňky patří k ošetření — na homepage
   by jen rozbily mřížku. Zbylých šest kategorií vyplní dva čisté řádky. */
const hiddenOnHome = ['voucher', 'doplnkove'];
const services = pricingData.filter(s => !hiddenOnHome.includes(s.id));
---

<section class="services section" id="sluzby" aria-label="Nabídka služeb">
  <div class="container">
    <SectionHeading
      label="Nabídka"
      title="Co pro Vás mohu udělat"
      subtitle="Každé ošetření přizpůsobuji stavu Vaší pleti. Pracuji výhradně s kosmeceutikou Larens."
    />

    <ul class="services__grid" role="list" data-animate>
      {services.map(service => (
        <li>
          <a href={`/sluzby#${service.id}`} class="svc">
            <span class="svc__icon" aria-hidden="true" set:html={service.icon} />
            <h3 class="svc__title">{service.category}</h3>
            <p class="svc__desc">{service.summary}</p>
            <span class="svc__meta">
              <span class="svc__price">
                {service.priceFrom.includes('Kč') ? `od ${service.priceFrom}` : service.priceFrom}
              </span>
              <span class="svc__duration">{service.durationRange}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="services__cta">
      <Button href="/cenik" variant="outline" size="lg">Celý ceník</Button>
    </div>
  </div>
</section>

<style>
  .services__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .svc {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-8);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .svc:hover {
    border-color: var(--color-accent-light);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .svc__icon {
    color: var(--color-gold);
    margin-bottom: var(--space-5);
    line-height: 0;
  }

  .svc__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .svc__desc {
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    line-height: 1.7;
    color: var(--color-text-soft);
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .svc__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .svc__price {
    font-size: var(--text-base);
    color: var(--color-accent);
  }

  .svc__duration {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .services__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-12);
  }

  @media (max-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .svc {
      padding: var(--space-6);
    }
  }
</style>
