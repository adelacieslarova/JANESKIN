---
import Button from '../ui/Button.astro';

/* Stejné čtyři body jako na tištěném banneru u salonu — ať web a polep mluví
   stejně. Každý vede na příslušnou kategorii ve službách. */
const bannerItems = [
  { label: 'Profesionální péče o pleť', href: '/sluzby#kosmeticka-pece' },
  { label: 'Anti-aging ošetření', href: '/sluzby#kosmeticka-pece' },
  { label: 'Microneedling', href: '/sluzby#microneedling' },
  { label: 'Lash lifting řas a laminace obočí', href: '/sluzby#laminace' },
];
---

<section class="hero" aria-label="Uvítací sekce">
  <div class="hero__bg">
    <!-- Video je jen kulisa: bez zvuku, ve smyčce, čtečky ho přeskočí.
         Na mobilu jde svislá verze, ať se z široké nevyřízne jen proužek. -->
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/janeskin-hero-poster.jpg"
      aria-hidden="true"
      tabindex="-1"
    >
      <source media="(max-width: 768px)" src="/video/janeskin-hero-mobil.mp4" type="video/mp4" />
      <source src="/video/janeskin-hero.webm" type="video/webm" />
      <source src="/video/janeskin-hero.mp4" type="video/mp4" />
    </video>
    <!-- Tmavý překryv, ať je světlý text na videu čitelný -->
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__content">
      <div class="hero__text">
        <p class="hero__label" data-animate data-delay="100">Kosmetický salon · Dolní Lutyně</p>
        <h1 class="hero__title" data-animate data-delay="200">Péče o Vaši pleť<br />s láskou, odborností<br />a vědou</h1>
        <hr class="hero__rule" data-animate data-delay="250" />
        <p class="hero__subtitle" data-animate data-delay="300">
          Osobní přístup a kosmeceutická péče Larens pro každý typ pleti.
        </p>
        <div class="hero__actions" data-animate data-delay="400">
          <Button href="https://noona.app/cs/janeskinsalonjanaszymikova" variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
          <Button href="/sluzby" variant="outline" size="lg">Prohlédnout služby</Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tmavý pruh jako dole na banneru -->
  <div class="hero__strip">
    <ul class="hero__strip-inner" role="list">
      {bannerItems.map(item => (
        <li class="hero__strip-item">
          <a href={item.href} class="hero__strip-link">{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
  }

  /* Video jde až nahoru pod průhledné menu; dole zbude místo na pruh se službami */
  .hero__bg {
    position: relative;
    z-index: 0;
    min-height: max(600px, calc(100svh - 64px));
    display: flex;
    overflow: hidden;
    background-color: var(--color-dark);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Hnědý překryv v barvě spodního pruhu (#3B290F), ne černý — drží teplý tón
     salonu. Uprostřed, kde leží text, je o něco hustší. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      /* nahoře tmavší pruh, ať je čitelné i průhledné menu */
      linear-gradient(to bottom, rgba(30, 20, 6, 0.38) 0%, rgba(30, 20, 6, 0) 22%),
      radial-gradient(ellipse at center, rgba(30, 20, 6, 0.22) 0%, rgba(30, 20, 6, 0) 70%),
      rgba(40, 27, 9, 0.32);
  }

  /* Content — horní odsazení o 72 px větší, text se středí pod menu */
  .hero__content {
    position: relative;
    z-index: 1;
    padding: calc(72px + var(--space-12)) var(--space-6) var(--space-12);
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__text {
    max-width: 760px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-accent-pale);
    margin-bottom: var(--space-5);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 5vw, var(--text-5xl));
    font-weight: var(--weight-regular);
    line-height: 1.15;
    color: var(--color-bg);
    text-shadow: 0 2px 24px rgba(30, 20, 6, 0.45);
    margin-bottom: var(--space-6);
  }

  .hero__rule {
    width: 64px;
    height: 1px;
    border: 0;
    background: var(--color-accent-light);
    margin: 0 0 var(--space-6);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    font-weight: var(--weight-light);
    color: var(--color-bg-alt);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: center;
  }

  /* Tlačítka na tmavém videu: hnědé by zaniklo, proto krémové a světlý obrys */
  .hero__actions :global(.btn--primary) {
    background-color: var(--color-bg-alt);
    border-color: var(--color-bg-alt);
    color: var(--color-dark);
  }
  .hero__actions :global(.btn--primary:hover) {
    background-color: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-dark);
  }
  .hero__actions :global(.btn--outline) {
    color: var(--color-bg-alt);
    border-color: rgba(248, 242, 226, 0.7);
  }
  .hero__actions :global(.btn--outline:hover) {
    background-color: rgba(248, 242, 226, 0.14);
    border-color: var(--color-bg-alt);
  }
  .hero__actions :global(.btn:focus-visible) {
    outline-color: var(--color-bg-alt);
  }

  /* Pruh se službami — hnědý jako spodní lišta banneru */
  .hero__strip {
    position: relative;
    z-index: 1;
    background: var(--color-dark);
  }

  .hero__strip-inner {
    list-style: none;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    align-items: center;
    justify-content: center;
  }

  .hero__strip-item {
    position: relative;
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__strip-link {
    color: #F8F2E2;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .hero__strip-link:hover {
    color: var(--color-accent-light);
    border-bottom-color: var(--color-accent-light);
  }

  .hero__strip-link:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 4px;
  }

  /* Zlatý oddělovač mezi body */
  .hero__strip-item + .hero__strip-item::before {
    content: '';
    position: absolute;
    left: calc(var(--space-10) / -2);
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent-light);
    transform: translate(-50%, -50%);
  }

  @media (max-width: 768px) {
    .hero__bg {
      min-height: max(520px, 78svh);
    }
    .hero__content {
      padding: calc(72px + var(--space-8)) var(--space-6) var(--space-10);
    }
    .hero__subtitle {
      font-size: var(--text-base);
    }
    .hero__strip-inner {
      gap: var(--space-3) var(--space-6);
      padding: var(--space-4) var(--space-6);
    }
    .hero__strip-item {
      font-size: var(--text-xs);
    }
    .hero__strip-item + .hero__strip-item::before {
      left: calc(var(--space-6) / -2);
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Kdo má v systému omezené animace, uvidí místo videa jen úvodní snímek */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
    .hero__bg {
      background: var(--color-dark) url('/video/janeskin-hero-poster.jpg') center / cover no-repeat;
    }
  }
</style>
