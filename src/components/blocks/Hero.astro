---
import Button from '../ui/Button.astro';

/* Stejné čtyři body jako na tištěném banneru u salonu — ať web a polep mluví
   stejně. Každý vede na příslušnou kategorii ve službách. */
const bannerItems = [
  { label: 'Profesionální péče o pleť', href: '/sluzby#kosmeticka-pece' },
  { label: 'Anti-aging ošetření', href: '/sluzby#kosmeticka-pece' },
  { label: 'Microneedling', href: '/sluzby#microneedling' },
  { label: 'Lash lifting řas a laminace obočí', href: '/sluzby#laminace' },
];
---

<section class="hero" aria-label="Uvítací sekce">
  <div class="hero__bg">
    <!-- Na mobilu je široká koláž jen tenký proužek — tam jde svislý výřez ošetření -->
    <picture>
      <source media="(max-width: 768px)" srcset="/images/hero-salon-mobil.jpg" width="810" height="1013" />
      <img
        src="/images/hero-salon.webp"
        alt="Kosmetický salon JANESKIN — kosmeceutika Larens a ošetření pleti"
        class="hero__img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="2160"
        height="1013"
      />
    </picture>
    <!-- Krémový závoj místo tmavého překryvu: fotka zůstane světlá, text čitelný -->
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__content">
      <div class="hero__text">
        <p class="hero__label" data-animate data-delay="100">Kosmetický salon · Dolní Lutyně</p>
        <h1 class="hero__title" data-animate data-delay="200">Péče o Vaši pleť<br />s láskou, odborností<br />a vědou</h1>
        <hr class="hero__rule" data-animate data-delay="250" />
        <p class="hero__subtitle" data-animate data-delay="300">
          Osobní přístup a kosmeceutická péče Larens pro každý typ pleti.
        </p>
        <div class="hero__actions" data-animate data-delay="400">
          <Button href="https://noona.app/cs/janeskinsalonjanaszymikova" variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
          <Button href="/sluzby" variant="outline" size="lg">Prohlédnout služby</Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tmavý pruh jako dole na banneru -->
  <div class="hero__strip">
    <ul class="hero__strip-inner" role="list">
      {bannerItems.map(item => (
        <li class="hero__strip-item">
          <a href={item.href} class="hero__strip-link">{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
  }

  /* Obrázek je v toku a určuje výšku, aby byl vidět celý */
  .hero__bg {
    position: relative;
    z-index: 0;
  }

  .hero__img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Krémový panel vlevo drží text. Barva je #F8F2E2 z banneru, ne skoro
     bílá #FDFAF3 — ta působila studeně vedle teplé fotky.

     Přechod je záměrně dlouhý a po malých krocích. Dřív padal z 0,72
     na nulu během dvanácti procent šířky a ta hrana se potkávala se
     spojem koláže přesně v polovině — dohromady to působilo jako řez.
     Teď se rozplývá až do 88 % a přes spoj jde s krytím 0,74. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(248, 242, 226, 0.98) 0%,
        rgba(248, 242, 226, 0.96) 35%,
        rgba(248, 242, 226, 0.90) 44%,
        rgba(248, 242, 226, 0.74) 50%,
        rgba(248, 242, 226, 0.52) 55%,
        rgba(248, 242, 226, 0.32) 60%,
        rgba(248, 242, 226, 0.16) 66%,
        rgba(248, 242, 226, 0.06) 72%,
        rgba(248, 242, 226, 0.01) 80%,
        rgba(248, 242, 226, 0) 88%
      ),
      /* Jen náznak přes celou plochu, ať panel nekončí ostře proti fotce.
         Víc než tohle už fotku zamlžuje — 0,16 dělalo opar. */
      linear-gradient(rgba(248, 242, 226, 0.04), rgba(248, 242, 226, 0.04));
  }

  /* Content */
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 120px var(--space-6) var(--space-10);
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .hero__text {
    max-width: 620px;
    text-align: left;
  }

  .hero__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-accent);
    margin-bottom: var(--space-5);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 5vw, var(--text-5xl));
    font-weight: var(--weight-regular);
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero__rule {
    width: 64px;
    height: 1px;
    border: 0;
    background: var(--color-accent-light);
    margin: 0 0 var(--space-6);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    font-weight: var(--weight-light);
    color: var(--color-text-soft);
    line-height: 1.7;
    max-width: 460px;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  /* Pruh se službami — hnědý jako spodní lišta banneru */
  .hero__strip {
    position: relative;
    z-index: 1;
    background: var(--color-dark);
  }

  .hero__strip-inner {
    list-style: none;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    align-items: center;
    justify-content: center;
  }

  .hero__strip-item {
    position: relative;
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__strip-link {
    color: #F8F2E2;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .hero__strip-link:hover {
    color: var(--color-accent-light);
    border-bottom-color: var(--color-accent-light);
  }

  .hero__strip-link:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 4px;
  }

  /* Zlatý oddělovač mezi body */
  .hero__strip-item + .hero__strip-item::before {
    content: '';
    position: absolute;
    left: calc(var(--space-10) / -2);
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent-light);
    transform: translate(-50%, -50%);
  }

  /* Fotka je široká (2160×1013): pod 1280px se text nevejde → jde pod obrázek */
  @media (max-width: 1280px) {
    /* Text už neleží na fotce, takže fotka musí začít pod fixní hlavičkou —
       jinak jí hlavička ukrojí horních 72 px i s hlavami. */
    .hero {
      padding-top: 72px;
    }
    .hero__content {
      position: static;
      padding: var(--space-12) var(--space-6);
    }
    /* Panel tu není potřeba (text je pod fotkou), ale nádech ano —
       jinak by fotka byla na užších oknech syrová a studenější. */
    .hero__veil {
      background: rgba(248, 242, 226, 0.04);
    }
    .hero__text {
      max-width: none;
    }
  }

  @media (min-width: 1281px) and (max-width: 1500px) {
    .hero__title {
      font-size: var(--text-4xl);
    }
    .hero__content {
      padding-top: 110px;
    }
  }

  @media (max-width: 768px) {
    .hero__subtitle {
      font-size: var(--text-base);
    }
    .hero__strip-inner {
      gap: var(--space-3) var(--space-6);
      padding: var(--space-4) var(--space-6);
    }
    .hero__strip-item {
      font-size: var(--text-xs);
    }
    .hero__strip-item + .hero__strip-item::before {
      left: calc(var(--space-6) / -2);
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
