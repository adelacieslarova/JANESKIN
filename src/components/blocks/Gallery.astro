---
/**
 * Galerie salonu — jednotná mřížka místo mozaiky.
 *
 * Fotky jsou skutečné snímky ze salonu; všechny se ořezávají na stejný
 * poměr 3:4, aby řádky seděly a sekce působila klidně.
 */
import SectionHeading from '../ui/SectionHeading.astro';

const photos = [
  { src: '/images/salon/salon-lehatko.jpg', alt: 'Ošetřovací lehátko v salonu JANESKIN' },
  { src: '/images/salon/osetreni-roller.jpg', alt: 'Kosmetické ošetření pleti zlatým masážním rollerem' },
  { src: '/images/salon/produkty-larens.jpg', alt: 'Přípravky Larens Professional Line na zlatém podnosu' },
  { src: '/images/salon/salon-pokoj.jpg', alt: 'Interiér kosmetického salonu JANESKIN' },
  { src: '/images/salon/produkty-kvetiny.jpg', alt: 'Kosmeceutika Larens a masážní pomůcky v salonu' },
  { src: '/images/salon/osetreni-masaz.jpg', alt: 'Masáž obličeje během kosmetického ošetření' },
];
---

<section class="gallery section section--alt" id="galerie" aria-label="Galerie salonu">
  <div class="container">
    <SectionHeading
      label="Galerie"
      title="Nahlédněte do salonu"
      subtitle="Místo, kde se o Vaši pleť postarám v klidu a soukromí — bez spěchu a čekáren."
    />
    <ul class="gallery__grid" role="list" data-animate>
      {photos.map(photo => (
        <li class="gallery__item">
          <img
            src={photo.src}
            alt={photo.alt}
            class="gallery__img"
            loading="lazy"
            decoding="async"
            width="900"
            height="1200"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .gallery__item {
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-bg-warm);
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .gallery__item:hover .gallery__img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item:hover .gallery__img {
      transform: none;
    }
  }
</style>
