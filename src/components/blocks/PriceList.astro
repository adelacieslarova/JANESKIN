---
/**
 * Výpis položek jedné kategorie.
 *
 * variant="full" (/sluzby): název, délka, cena a plný popis, vše viditelné.
 * variant="compact" (/cenik): jen název a cena — žádné popisy ani úvodní texty.
 *
 * Obě stránky sdílí tuhle komponentu, aby se markup nepsal dvakrát.
 */
import Badge from '../ui/Badge.astro';
import type { PriceCategory, PriceItem, PriceSubsection } from '../../data/pricing';

interface Props {
  category: PriceCategory;
  variant?: 'full' | 'compact';
}

const { category, variant = 'full' } = Astro.props;
const compact = variant === 'compact';

/** V ceníku ukazujeme z poznámek jen ty cenové (balíčky, kúry) — zbytek patří k popisu na /sluzby. */
const showNote = (item: PriceItem) => Boolean(item.note) && (!compact || /Kč/.test(item.note!));

const groups: PriceSubsection[] = category.subsections
  ? category.subsections
  : [{ title: null, items: category.items }];

/**
 * Popis ošetření je jeden dlouhý odstavec, ve kterém jsou schované dva výčty
 * ("Efekt:" a "Péče zahrnuje:"). Rozebereme ho na části,
 * ať se dá zobrazit přehledně.
 *
 * Rozdělovat umíme jen tam, kde je to bezpečné: středník je jednoznačný,
 * čárku bereme pouze u účinků a jen když v bloku nejsou tečky — jinak by
 * roztrhala věty uprostřed. Když si nejsme jistí, necháme odstavec být.
 */
const PROC_LABELS = ['Péče zahrnuje:'];

function splitItems(text: string, allowComma: boolean): string[] | null {
  const body = text.trim().replace(/\.$/, '');
  if (body.includes(';')) return body.split(';').map(s => s.trim()).filter(Boolean);
  if (allowComma && !body.includes('.') && body.includes(',')) {
    return body.split(',').map(s => s.trim()).filter(Boolean);
  }
  return null;
}

/** Za výčtem občas pokračují další věty (např. doporučení kúry) — ty patří pod něj. */
function splitListAndNote(text: string): [string, string] {
  const m = text.match(/\.\s+(?=[A-ZÁČĎÉĚÍŇÓŘŠŤÚŮÝŽ])/);
  if (!m || m.index === undefined) return [text, ''];
  const i = m.index + 1;
  return [text.slice(0, i), text.slice(i).trim()];
}

interface ParsedDesc {
  intro: string;
  effects: string[] | null;
  effectsText: string;
  procedure: string[] | null;
  procedureText: string;
  procLabel: string | null;
  note: string;
}

function parseDescription(text: string): ParsedDesc {
  const iEfekt = text.indexOf('Efekt:');
  const procLabel = PROC_LABELS.find(l => text.includes(l)) ?? null;
  const iProc = procLabel ? text.indexOf(procLabel) : -1;

  const empty: ParsedDesc = {
    intro: text, effects: null, effectsText: '',
    procedure: null, procedureText: '', procLabel: null, note: '',
  };
  if (iEfekt < 0 && iProc < 0) return empty;

  const intro = text.slice(0, Math.min(...[iEfekt, iProc].filter(i => i >= 0))).trim();

  let effects: string[] | null = null;
  let effectsText = '';
  if (iEfekt >= 0) {
    const end = iProc > iEfekt ? iProc : text.length;
    effectsText = text.slice(iEfekt + 'Efekt:'.length, end).trim();
    effects = splitItems(effectsText, true);
  }

  let procedure: string[] | null = null;
  let procedureText = '';
  let note = '';
  if (iProc >= 0 && procLabel) {
    const [list, rest] = splitListAndNote(text.slice(iProc + procLabel.length));
    procedureText = list.trim();
    procedure = splitItems(list, false);
    note = rest;
  }

  return { intro, effects, effectsText, procedure, procedureText, procLabel, note };
}
---

{category.note && <p class="price-list__note">{category.note}</p>}
{!compact && category.intro && <p class="price-list__intro">{category.intro}</p>}

{groups.map((group: PriceSubsection) => (
  <>
    {group.title && <h4 class="price-list__subtitle">{group.title}</h4>}
    {group.items.length > 0 && (
      <ul class:list={['price-list', compact && 'price-list--compact']} role="list">
        {group.items.map((item: PriceItem) => (
          <li class="price-item">
            <div class="price-item__head">
              <h5 class="price-item__name">
                {item.name}
                {showNote(item) && <span class="price-item__tag">{item.note}</span>}
              </h5>
              <div class="price-item__meta">
                {item.duration && <span class="price-item__duration">{item.duration}</span>}
                {item.price
                  ? <Badge text={item.price} variant="gold" />
                  : <span class="price-item__ondemand">Na dotaz</span>
                }
              </div>
            </div>
            {!compact && item.description && (() => {
              const d = parseDescription(item.description);
              return (
                <div class="price-item__body">
                  {d.intro && d.intro.split(/\n{2,}/).map((odstavec: string) => (
                    <p class="price-item__desc">{odstavec}</p>
                  ))}

                  {(d.effects || d.effectsText) && (
                    <div class="desc-block">
                      <p class="desc-block__label">Efekt</p>
                      {d.effects
                        ? <ul class="desc-block__list" role="list">{d.effects.map(e => <li>{e}</li>)}</ul>
                        : <p class="price-item__desc">{d.effectsText}</p>}
                    </div>
                  )}

                  {(d.procedure || d.procedureText) && (
                    <div class="desc-block">
                      <p class="desc-block__label">{d.procLabel?.replace(':', '')}</p>
                      {d.procedure
                        ? <ul class="desc-block__list" role="list">{d.procedure.map(p => <li>{p}</li>)}</ul>
                        : <p class="price-item__desc">{d.procedureText}</p>}
                    </div>
                  )}

                  {d.note && <p class="price-item__desc price-item__desc--note">{d.note}</p>}
                </div>
              );
            })()}
          </li>
        ))}
      </ul>
    )}
  </>
))}

<style>
  .price-list__note {
    font-size: var(--text-sm);
    color: var(--color-accent-hover);
    font-style: italic;
    margin-bottom: var(--space-5);
  }

  .price-list__intro {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    line-height: 1.75;
    margin-bottom: var(--space-6);
    max-width: 72ch;
  }

  .price-list__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-accent-light);
  }

  .price-list__subtitle:first-of-type {
    margin-top: 0;
  }

  .price-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .price-item {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .price-item:last-child {
    border-bottom: none;
  }

  .price-item__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .price-item__name {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    line-height: 1.45;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .price-item__tag {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-accent-hover);
    background-color: var(--color-accent-light);
    border-radius: var(--radius-full);
    padding: 2px var(--space-3);
    font-style: italic;
    white-space: nowrap;
  }

  .price-item__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .price-item__duration {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .price-item__ondemand {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Kompaktní ceník: jen řádek název — cena, hustší sazba */
  .price-list--compact .price-item {
    padding: var(--space-3) 0;
  }

  .price-list--compact .price-item__head {
    gap: var(--space-4);
  }

  .price-item__desc {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    line-height: 1.8;
    margin-top: var(--space-3);
    max-width: 78ch;
  }

  /* Delší popisy jdou po odstavcích — mezera mezi nimi musí být
     zřetelně větší než rozestup řádků, jinak splynou v jeden blok. */
  .price-item__desc + .price-item__desc {
    margin-top: var(--space-4);
  }

  .price-item__desc--note {
    font-style: italic;
  }

  /* ── Efekt / Procedura ── */
  .desc-block {
    margin-top: var(--space-4);
    max-width: 78ch;
  }

  .desc-block__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  /* Sloupce místo mřížky: položky plynou pod sebou, takže delší text
     nevytváří v řádku prázdné mezery. */
  .desc-block__list {
    list-style: none;
    columns: 2;
    column-gap: var(--space-8);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-soft);
  }

  .desc-block__list li {
    position: relative;
    padding-left: var(--space-4);
    margin-bottom: var(--space-1);
    break-inside: avoid;
  }

  /* Zlatá tečka místo klasické odrážky */
  .desc-block__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-light);
  }

  @media (max-width: 860px) {
    .desc-block__list {
      columns: 1;
    }
  }

  @media (max-width: 640px) {
    .price-item__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
