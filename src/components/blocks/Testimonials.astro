---
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Jen skutečné recenze, převzaté beze změn z Map Google a Firmy.cz (stav 17. 9. 2026, Google 13 recenzí, Seznam 8).
 * Vymyšlené reference zákon o ochraně spotřebitele zakazuje — nové sem přidávej
 * jen zkopírované z veřejného profilu, se zdrojem. Příjmení zkracujeme na iniciálu.
 */
const GOOGLE_URL =
  'https://www.google.com/maps/place/JANESKIN-+SALON+JANA+SZYMIKOV%C3%81/@49.8975948,18.4221274,17z/data=!4m8!3m7!1s0x471157340ba6c399:0x5527b06384e96700!8m2!3d49.8975914!4d18.4247077!9m1!1b1!16s%2Fg%2F11x2kr9xfq';
const SEZNAM_URL = 'https://www.firmy.cz/detail/13747453-janeskin-salon-jana-szymikova-dolni-lutyne.html';

type Source = 'Google' | 'Seznam';

const reviews: { author: string; source: Source; text: string }[] = [
  {
    author: 'Natálie O.',
    source: 'Google',
    text: 'V salonu jsem byla poprvé a rozhodně ne naposledy. Krásné prostředí, profesionální přístup a hlavně skvělý výsledek. Celou dobu jsem se cítila velmi příjemně a opečovávaně. Kosmetička Janča mi vše hezky vysvětlila, poradila s péčí o pleť i s výběrem vhodné kosmetiky pro můj typ pleti. Oceňuji její milý a profesionální přístup. 100% spokojenost, moc doporučuji!',
  },
  {
    author: 'Gabriela S.',
    source: 'Google',
    text: 'Paní Jana má velice profesionální přístup k zákazníci a to že před prvním ošetřením s vámi dělá dotazník mě opravdu mile překvapilo. Svým klientům se věnuje na 150% ,ochotně s vámi probere vaše kosmetické problémy a doporučí kosmetiku. Já jsem z první návštěvy byla unešená. Nejlepší na tom všem byl výsledek po ošetření. Moje pleť jen zářila, bylo to ohromující. Budu se opakovaně vracet. Tento salon doporučuji !!!',
  },
  {
    author: 'Irena B.',
    source: 'Google',
    text: 'Do salonu Janeskin jsem šla poprvé a byla jsem naprosto nadšená. Paní Janka je skutečná profesionálka, která svou práci dělá srdcem – je to vidět na každém detailu. Cítila jsem se v jejích rukou maximálně opečovávaná a zároveň v luxusním prostředí, kde nechybí příjemná atmosféra. Výsledek předčil moje očekávání a určitě se sem budu ráda vracet. Mohu jen doporučit! 💛',
  },
  {
    author: 'Andrea S.',
    source: 'Google',
    text: 'Kosmetický salón mohu jen doporučit. Prostředí je čisté, moderní a velmi útulné, takže se člověk hned cítí pohodlně a může si skutečně odpočinout. Paní kosmetička mi vše podrobně vysvětlila, doporučila vhodné ošetření podle potřeb mé pleti a po celou dobu se věnovala maximálně pečlivě. Velmi se těším na další návštěvu.',
  },
  {
    author: 'Markéta K.',
    source: 'Seznam',
    text: 'Kosmetické ošetření jsem si moc užila. Byla jsem velmi spokojená - odnesla si spoustu užitečných informací, ošetření bylo kvalitní a profesionální. Jako bonus jsem si krásně odpočinula a zrelaxovala. Určitě doporučuji!',
  },
  {
    author: 'Radmila N.',
    source: 'Google',
    text: 'Paní Jana je velice milá a příjemná, v jejím salonu si člověk vždy odpočine a v příjemném prostředí se pod jejíma rukama cítí opravdu hýčkán. Doporučuji návštěvu jeji salonu všemi deseti. ☘️Zároveň vždy poradí jak se správně starat o svou pleť.',
  },
  {
    author: 'Karolína K.',
    source: 'Google',
    text: 'Po první návštěvě jsem odcházela nadšená. Prostředí, přístup, analýza pleti, produkty - maximální spokojenost. Konečně jsem se o své pleti něco dozvěděla a vybraly jsme další vhodný postup. Děkuji.',
  },
  {
    author: 'Radka K.',
    source: 'Google',
    text: 'Salon Janeskin jsem navštívila poprvé a odcházela jsem velice spokojená. Prostředí je opravdu příjemné, péče a poradenství na vysoké úrovni a majitelka salonu moc milá. Už se těším na další návštěvu!!',
  },
  {
    author: 'Kateřina H.',
    source: 'Google',
    text: 'Moc doporučuji salon Janeskin. Péče je skvělá a na velmi vysoké úrovni. Salon jsem navštívila již opakovaně a pokaždé veliká spokojenost. Pokud hledáte kvalitní péči o vaši pleť a relaxaci v krásném prostředí, vřele doporučuji 🤗',
  },
  {
    author: 'Lenka Č.',
    source: 'Google',
    text: 'Krásně strávené dvě hodinky, kdy se o mě Janička krásně starala. Výsledek líčení naprostá spokojenost a vřele doporučuji i dalším ženám, pokud hledají relaxaci, péči a Top výsledek, tak tady jste na správné adrese. 🌸',
  },
  {
    author: 'Zuzana W.',
    source: 'Seznam',
    text: 'Velmi kvalitní a osobní přístup. Pani ví co dělá, masáže luxusní a kosmetická péče se vším všudy :) doporučuji',
  },
  {
    author: 'K. Juri',
    source: 'Google',
    text: 'Skvělá péče a luxusní kosmetika, určitě se oplatí do ni investovat 😊 nebyla jsem spokojena s texturou pleti a po této kosmetice se mi krásně zlepšila, můžu jen doporučit a vyzdvihnout taky skvělý přístup kosmetičky 😊',
  },
  {
    author: 'Jana K.',
    source: 'Google',
    text: 'V salonu Janeskin jsem byla poprvé a byla jsem velmi spokojená, péče o mě byla na vysoké úrovni. Mohu všem vřele doporučit.',
  },
  {
    author: 'Šárka M.',
    source: 'Google',
    text: 'Salon mohu jen doporučit. Moc krásné prostředí, profesionální přístup a příjemná atmosféra. Byla jsem poprvé a určitě se vrátím.',
  },
  {
    author: 'Lucie S.',
    source: 'Google',
    text: 'Velká spokojenost. Příjemné prostředí a perfektní péče.',
  },
];

const star = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
const stars = star.repeat(5);
---

<section class="testimonials section" id="recenze" aria-label="Recenze klientek">
  <div class="container">
    <SectionHeading
      label="Recenze"
      title="Co říkají moje klientky"
    />

    <div class="testimonials__ratings">
      <a href={GOOGLE_URL} class="rating" target="_blank" rel="noopener noreferrer">
        <span class="rating__stars" set:html={stars} />
        <span class="rating__text"><strong>5,0</strong> na Googlu (13 recenzí)</span>
      </a>
      <a href={SEZNAM_URL} class="rating" target="_blank" rel="noopener noreferrer">
        <span class="rating__stars" set:html={stars} />
        <span class="rating__text"><strong>5,0</strong> na Seznamu (8 hodnocení)</span>
      </a>
    </div>

    <div class="testimonials__carousel" data-animate>
      <ul class="testimonials__track" id="testimonials-track" role="list" tabindex="0" aria-label="Recenze klientek — posuňte do strany">
        {reviews.map(r => (
          <li class="review">
            <span class="review__stars" role="img" aria-label="5 hvězdiček z 5" set:html={stars} />
            <p class="review__text">{r.text}</p>
            <footer class="review__footer">
              <span class="review__avatar" aria-hidden="true">{r.author.charAt(0)}</span>
              <span class="review__meta">
                <span class="review__author">{r.author}</span>
                <span class="review__source">Recenze na {r.source === 'Google' ? 'Googlu' : 'Seznamu'}</span>
              </span>
            </footer>
          </li>
        ))}
      </ul>

      <div class="testimonials__controls">
        <button class="testimonials__btn" id="testimonials-prev" type="button" aria-label="Předchozí recenze">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="testimonials__btn" id="testimonials-next" type="button" aria-label="Další recenze">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <p class="testimonials__note">
      Recenze jsou převzaté beze změn z&nbsp;<a href={GOOGLE_URL} target="_blank" rel="noopener noreferrer">Map Google</a>
      a&nbsp;<a href={SEZNAM_URL} target="_blank" rel="noopener noreferrer">Firmy.cz</a>, kde je zveřejnily samy klientky.
    </p>
  </div>
</section>

<style>
  /* ── Souhrnné hodnocení ── */
  .testimonials__ratings {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: var(--space-10);
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-white);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .rating:hover {
    border-color: var(--color-accent-light);
  }

  .rating strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .rating__stars,
  .review__stars {
    display: inline-flex;
    gap: 1px;
    color: var(--color-accent-light);
  }

  /* ── Karusel ── */
  .testimonials__track {
    --gap: var(--space-6);
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-block: var(--space-1);
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__track:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .review {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .review__text {
    flex: 1;
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
  }

  .review__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .review__avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-warm);
    color: var(--color-accent-hover);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review__meta {
    display: flex;
    flex-direction: column;
  }

  .review__author {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .review__source {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  /* ── Šipky ── */
  .testimonials__controls {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .testimonials__btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-text-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast), color var(--transition-fast), opacity var(--transition-fast);
  }

  .testimonials__btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .testimonials__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .testimonials__note {
    margin-top: var(--space-6);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  .testimonials__note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .testimonials__track {
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }

  @media (max-width: 640px) {
    .testimonials__track {
      --gap: var(--space-4);
      grid-auto-columns: 85%;
    }
    .review {
      padding: var(--space-5);
    }
  }
</style>

<script>
  const track = document.getElementById('testimonials-track');
  const prev = document.getElementById('testimonials-prev') as HTMLButtonElement | null;
  const next = document.getElementById('testimonials-next') as HTMLButtonElement | null;

  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('.review');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
