---
import SectionHeading from '../ui/SectionHeading.astro';
import { GOOGLE_URL, SEZNAM_URL, ratings, reviews } from '../../data/reviews';
/* Loga jsou jednobarevná (fill="currentColor"), barvu jim dává CSS */
import googleLogo from '../../assets/logos/google.svg?raw';
import seznamLogo from '../../assets/logos/seznam.svg?raw';

const star = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
const stars = star.repeat(5);
---

<section class="testimonials section" id="recenze" aria-label="Recenze klientek">
  <div class="container">
    <SectionHeading
      label="Recenze"
      title="Co říkají moje klientky"
    />

    <div class="testimonials__ratings">
      <a href={GOOGLE_URL} class="rating" target="_blank" rel="noopener noreferrer">
        <span class="rating__logo rating__logo--google" role="img" aria-label="Google" set:html={googleLogo} />
        <span class="rating__stars" aria-hidden="true" set:html={stars} />
        <span class="rating__text"><strong>{ratings.google.score}</strong> ({ratings.google.count} hodnocení)</span>
      </a>
      <a href={SEZNAM_URL} class="rating" target="_blank" rel="noopener noreferrer">
        <span class="rating__logo rating__logo--seznam" role="img" aria-label="Seznam.cz" set:html={seznamLogo} />
        <span class="rating__stars" aria-hidden="true" set:html={stars} />
        <span class="rating__text"><strong>{ratings.seznam.score}</strong> ({ratings.seznam.count} hodnocení)</span>
      </a>
    </div>

    <div class="testimonials__carousel" data-animate>
      <ul class="testimonials__track" id="testimonials-track" role="list" tabindex="0" aria-label="Recenze klientek — posuňte do strany">
        {reviews.map(r => (
          <li class="review">
            <span class="review__stars" role="img" aria-label="5 hvězdiček z 5" set:html={stars} />
            <p class="review__text">{r.text}</p>
            <button type="button" class="review__more" aria-expanded="false" hidden>Zobrazit více</button>
            <footer class="review__footer">
              <span class="review__avatar" aria-hidden="true">{r.author.charAt(0)}</span>
              <span class="review__meta">
                <span class="review__author">{r.author}</span>
                <span class="review__source">Recenze na {r.source === 'Google' ? 'Googlu' : 'Seznamu'}</span>
              </span>
            </footer>
          </li>
        ))}
      </ul>

      <div class="testimonials__controls">
        <button class="testimonials__btn" id="testimonials-prev" type="button" aria-label="Předchozí recenze">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="testimonials__btn" id="testimonials-next" type="button" aria-label="Další recenze">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <p class="testimonials__more">
      <a href="/recenze" class="testimonials__more-link">Všechny recenze na jednom místě <span aria-hidden="true">→</span></a>
    </p>

    <p class="testimonials__note">
      Recenze jsou převzaté beze změn z&nbsp;<a href={GOOGLE_URL} target="_blank" rel="noopener noreferrer">Map Google</a>
      a&nbsp;<a href={SEZNAM_URL} target="_blank" rel="noopener noreferrer">Firmy.cz</a>, kde je zveřejnily samy klientky.
    </p>
  </div>
</section>

<style>
  /* ── Souhrnné hodnocení ── */
  .testimonials__ratings {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    margin-top: calc(-1 * var(--space-6));
    margin-bottom: var(--space-10);
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-white);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .rating:hover {
    border-color: var(--color-accent-light);
  }

  .rating strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* Loga Googlu a Seznamu ve zlaté JANESKIN, stejně jako na stránce /recenze;
     různé výšky vyrovnávají opticky stejnou velikost písma obou nápisů. */
  .rating__logo {
    display: inline-flex;
    align-items: center;
    margin-right: var(--space-1);
    color: var(--color-gold);
  }

  .rating__logo :global(svg) {
    display: block;
    width: auto;
  }

  .rating__logo--google :global(svg) {
    height: 20px;
  }

  .rating__logo--seznam :global(svg) {
    height: 17px;
  }

  .rating__stars,
  .review__stars {
    display: inline-flex;
    gap: 1px;
    color: var(--color-accent-light);
  }

  /* ── Karusel ── */
  .testimonials__track {
    --gap: var(--space-6);
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-block: var(--space-1);
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__track:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .review {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .review__text {
    white-space: pre-line;
    flex: 1;
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
  }

  /* Delší recenze se zkrátí na šest řádků a rozbalí tlačítkem — karty pak
     vycházejí stejně vysoké. Třídu přidává skript, bez něj je text vidět celý. */
  .review__text.is-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  .review__more {
    align-self: flex-start;
    margin-top: calc(-1 * var(--space-2));
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid var(--color-accent-light);
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .review__more:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  .review__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .review__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .review__avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-warm);
    color: var(--color-accent-hover);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review__meta {
    display: flex;
    flex-direction: column;
  }

  .review__author {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .review__source {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  /* ── Šipky ── */
  .testimonials__controls {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .testimonials__btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-text-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast), color var(--transition-fast), opacity var(--transition-fast);
  }

  .testimonials__btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .testimonials__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .testimonials__more {
    margin-top: var(--space-8);
    text-align: center;
  }

  .testimonials__more-link {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-light);
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .testimonials__more-link:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  .testimonials__note {
    margin-top: var(--space-6);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  .testimonials__note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .testimonials__track {
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }

  @media (max-width: 640px) {
    .testimonials__track {
      --gap: var(--space-4);
      grid-auto-columns: 85%;
    }
    .review {
      padding: var(--space-5);
    }
  }
</style>

<script>
  const track = document.getElementById('testimonials-track');
  const prev = document.getElementById('testimonials-prev') as HTMLButtonElement | null;
  const next = document.getElementById('testimonials-next') as HTMLButtonElement | null;

  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('.review');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  /* Zobrazit více / méně u delších recenzí */
  const cards = document.querySelectorAll<HTMLElement>('.review');
  const measure = () => {
    cards.forEach(card => {
      const text = card.querySelector<HTMLElement>('.review__text');
      const more = card.querySelector<HTMLButtonElement>('.review__more');
      if (!text || !more || more.getAttribute('aria-expanded') === 'true') return;
      text.classList.add('is-clamped');
      more.hidden = text.scrollHeight <= text.clientHeight + 2;
    });
  };
  cards.forEach(card => {
    const text = card.querySelector<HTMLElement>('.review__text');
    const more = card.querySelector<HTMLButtonElement>('.review__more');
    if (!text || !more) return;
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? 'Zobrazit méně' : 'Zobrazit více';
      text.classList.toggle('is-clamped', !open);
    });
  });
  measure();
  window.addEventListener('resize', measure);
  document.fonts?.ready.then(measure);
</script>
