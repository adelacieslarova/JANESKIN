---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  breadcrumb?: { label: string; href: string }[];
  /** Fotka jako jemný podklad pásu — překrytá závojem v barvě pásu */
  image?: string;
  /** Výřez fotky (CSS object-position), výchozí „center center“ */
  imagePosition?: string;
  /** Fotka pokračuje až nahoru pod menu; menu je nahoře průhledné a po odscrollování se zase zbarví */
  fullBleed?: boolean;
}

const { label, title, subtitle, breadcrumb, image, imagePosition, fullBleed = false } = Astro.props;
const bleed = Boolean(image) && fullBleed;
---

{bleed && (
  <style
    is:inline
    set:html={
      '.header--band:not(.header--scrolled){background-color:transparent!important;' +
      'backdrop-filter:none!important;-webkit-backdrop-filter:none!important}'
    }
  />
)}

<section class={`page-header${image ? ' page-header--photo' : ''}${bleed ? ' page-header--bleed' : ''}`} aria-label="Záhlaví stránky">
  {image && (
    <div class="page-header__bg" aria-hidden="true">
      <img
        src={image}
        alt=""
        class="page-header__bg-img"
        style={imagePosition ? `object-position: ${imagePosition}` : undefined}
        width="1800"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="page-header__veil"></div>
    </div>
  )}

  <div class="page-header__inner container">
    {breadcrumb && (
      <nav class="page-header__breadcrumb" aria-label="Drobečková navigace">
        <ol class="page-header__breadcrumb-list" role="list">
          <li>
            <a href="/" class="page-header__breadcrumb-link">Úvod</a>
          </li>
          {breadcrumb.map((crumb, i) => (
            <li>
              <span class="page-header__breadcrumb-sep" aria-hidden="true">/</span>
              {i === breadcrumb.length - 1 ? (
                <span class="page-header__breadcrumb-current" aria-current="page">{crumb.label}</span>
              ) : (
                <a href={crumb.href} class="page-header__breadcrumb-link">{crumb.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="page-header__text">
      {label && <p class="page-header__label">{label}</p>}
      <h1 class="page-header__title">{title}</h1>
      {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style>
  /* Béžový pás (--color-band, o dva odstíny tmavší než banner) — fotky v záhlaví podstránek rušily,
     tmavě hnědá byla moc těžká. Začíná na y:0 za pevnou hlavičkou, která
     má nahoře stejnou barvu, takže spolu splývají. */
  .page-header {
    position: relative;
    background-color: var(--color-band);
    border-bottom: 1px solid var(--color-border);
    padding-top: calc(72px + var(--space-6));
    padding-bottom: var(--space-12);
  }

  /* Fotka je jen jemný podklad: závoj v barvě pásu ji ztiší tak,
     aby všechny podstránky působily jako jedna plocha a text zůstal čitelný. */
  .page-header__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .page-header__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: saturate(0.92);
  }

  .page-header__veil {
    position: absolute;
    inset: 0;
    /* Uprostřed, kde je text, je závoj hustší; ke krajům fotku pouští víc. */
    background:
      radial-gradient(
        70% 130% at 50% 50%,
        rgba(237, 221, 181, 0.82) 0%,
        rgba(237, 221, 181, 0.62) 55%,
        rgba(237, 221, 181, 0.48) 100%
      );
  }

  /* Pod průhledným menu je fotka o něco světlejší, ať je logo a menu čitelné. */
  .page-header--bleed .page-header__veil::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 130px;
    background: linear-gradient(to bottom, rgba(237, 221, 181, 0.55) 0%, rgba(237, 221, 181, 0) 100%);
  }

  /* Fotka jde až nahoru pod průhledné menu — text potřebuje větší odstup. */
  .page-header--bleed {
    padding-top: calc(72px + var(--space-10));
    padding-bottom: var(--space-16);
  }

  .page-header__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  /* ── Breadcrumb ── */
  .page-header__breadcrumb-list {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-soft);
  }

  .page-header__breadcrumb-list li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .page-header__breadcrumb-link {
    color: var(--color-text-soft);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .page-header__breadcrumb-link:hover {
    color: var(--color-accent);
  }

  .page-header__breadcrumb-sep {
    color: var(--color-accent-light);
  }

  .page-header__breadcrumb-current {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* ── Text ── */
  .page-header__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .page-header__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .page-header__title {
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 6vw, var(--text-5xl));
    font-weight: var(--weight-medium);
    color: var(--color-text);
    line-height: 1.15;
    text-wrap: balance;
  }

  .page-header__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-soft);
    line-height: 1.6;
    max-width: 640px;
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .page-header {
      padding-top: calc(72px + var(--space-4));
      padding-bottom: var(--space-8);
    }
    .page-header__inner {
      gap: var(--space-4);
    }
    .page-header__title {
      font-size: var(--text-4xl);
    }
    .page-header__subtitle {
      font-size: var(--text-lg);
    }
  }
</style>
