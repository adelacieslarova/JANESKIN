---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import PriceList from '../components/blocks/PriceList.astro';
import { pricingData, BOOKING_URL } from '../data/pricing';
---

<Layout
  title="Ceník"
  description="Ceník kosmetického salonu JANESKIN — Dolní Lutyně. Ceny všech ošetření, masáží, laminací, vizážistiky a svatebních balíčků. Jana Szymiková."
>
  <PageHeader
    title="Ceník služeb"
    subtitle="Přehledný ceník všech ošetření. Ceny jsou orientační — konečná cena závisí na délce a rozsahu ošetření."
    breadcrumb={[{ label: 'Ceník', href: '/cenik' }]}
    image="/images/bg-cenik.webp"
  />

  <!-- Kategorie navigace -->
  <div class="cenik-nav">
    <div class="container">
      <ul class="cenik-nav__list" role="list">
        {pricingData.map(cat => (
          <li>
            <a href={`#${cat.id}`} class="cenik-nav__link">{cat.category}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="cenik-content section">
    <div class="container">
      {pricingData.map(cat => (
        <section class="price-category" id={cat.id} aria-label={cat.category} data-animate>
          <h2 class="price-category__title">{cat.category}</h2>
          <PriceList category={cat} />
        </section>
      ))}

      <div class="cenik-cta">
        <Button href={BOOKING_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
        <Button href="tel:+420724239998" variant="outline" size="lg">Zavolat</Button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Category nav */
  .cenik-nav {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 72px;
    z-index: calc(var(--z-header) - 1);
  }

  .cenik-nav__list {
    list-style: none;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cenik-nav__list::-webkit-scrollbar { display: none; }

  .cenik-nav__link {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-soft);
    text-decoration: none;
    padding: var(--space-4) var(--space-4);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .cenik-nav__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Price categories */
  .price-category {
    margin-bottom: var(--space-16);
    scroll-margin-top: calc(72px + 48px);
  }

  .price-category__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-accent-light);
    margin-bottom: var(--space-5);
  }

  /* CTA */
  .cenik-cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }

  @media (max-width: 640px) {
    .cenik-cta {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
