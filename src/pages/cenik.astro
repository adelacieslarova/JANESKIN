---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import PriceList from '../components/blocks/PriceList.astro';
import CategoryNav from '../components/blocks/CategoryNav.astro';
import { pricingData, BOOKING_URL, PRICES_VALID_FROM } from '../data/pricing';
---

<Layout
  title="Ceník"
  description="Ceník kosmetického salonu JANESKIN — Dolní Lutyně. Ceny všech ošetření, masáží, laminací, vizážistiky a svatebních balíčků. Jana Szymiková."
>
  <PageHeader
    title="Ceník služeb"
    subtitle="Přehledný ceník všech ošetření, doplňkových služeb i vizáže."
    breadcrumb={[{ label: 'Ceník', href: '/cenik' }]}
    image="/images/salon/larens-professional-line-kompletni-rada.jpg"
    imageFit="contain"
    fullBleed
  />

  <!-- Kategorie navigace -->
  <CategoryNav tight />

  <div class="cenik-content section">
    <div class="container">
      <p class="cenik-valid">Ceník je platný od {PRICES_VALID_FROM}</p>

      {pricingData.map(cat => (
        <section class="price-category" id={cat.id} aria-label={cat.category} data-animate>
          <h2 class="price-category__title">{cat.category}</h2>
          <PriceList category={cat} variant="compact" />
        </section>
      ))}

      <div class="cenik-cta">
        <Button href={BOOKING_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
        <Button href="tel:+420724239998" variant="outline" size="lg">Zavolat</Button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cenik-valid {
    margin-bottom: var(--space-10);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  /* Price categories */
  .price-category {
    margin-bottom: var(--space-16);
    scroll-margin-top: calc(72px + 48px);
  }

  .price-category__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-accent-light);
    margin-bottom: var(--space-5);
  }

  /* CTA */
  .cenik-cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
  }

  @media (max-width: 640px) {
    .cenik-cta {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
