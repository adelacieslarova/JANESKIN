---
/**
 * Recenze klientek na samostatné stránce.
 *
 * Nahoře souhrnné skóre z Googlu a Seznamu, pod ním všechny recenze.
 * Texty i čísla se berou ze src/data/reviews.ts — stejná data jako
 * karusel na úvodní stránce, takže se nemůžou rozejít.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { BOOKING_URL } from '../data/pricing';
import { GOOGLE_URL, SEZNAM_URL, ratings, reviews } from '../data/reviews';
/* Loga jsou jednobarevná (fill="currentColor"), barvu jim dává CSS */
import googleLogo from '../assets/logos/google.svg?raw';
import seznamLogo from '../assets/logos/seznam.svg?raw';

const star = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
const stars = star.repeat(5);

---

<Layout
  title="Recenze klientek"
  description={`Recenze kosmetického salonu JANESKIN v Dolní Lutyni s hodnocením ${ratings.google.score} z 5 na Googlu i na Seznamu. Přečtěte si, co o péči Jany Szymikové píšou klientky.`}
>
  <PageHeader
    label="Recenze"
    title="Co říkají moje klientky"
    subtitle="Skutečná hodnocení z Googlu a Seznamu tak, jak je klientky samy napsaly."
    breadcrumb={[{ label: 'Recenze', href: '/recenze' }]}
    image="/images/salon/klientka-s-kavou-kosmeticky-salon-janeskin-pruh.jpg"
    imageFit="contain"
    fullBleed
  />

  <!-- Souhrnné skóre -->
  <section class="score section" aria-label="Souhrnné hodnocení salonu">
    <div class="container">
      <div class="score__grid" data-animate>
        <a href={GOOGLE_URL} class="score__card" target="_blank" rel="noopener noreferrer">
          <span class="score__logo score__logo--google" role="img" aria-label="Google" set:html={googleLogo} />
          <span class="score__value">{ratings.google.score}</span>
          <span class="score__stars" role="img" aria-label="5 hvězdiček z 5" set:html={stars} />
          <span class="score__count">{ratings.google.count} hodnocení</span>
          <span class="score__link">Zobrazit na Googlu <span aria-hidden="true">→</span></span>
        </a>
        <a href={SEZNAM_URL} class="score__card" target="_blank" rel="noopener noreferrer">
          <span class="score__logo score__logo--seznam" role="img" aria-label="Seznam.cz" set:html={seznamLogo} />
          <span class="score__value">{ratings.seznam.score}</span>
          <span class="score__stars" role="img" aria-label="5 hvězdiček z 5" set:html={stars} />
          <span class="score__count">{ratings.seznam.count} hodnocení</span>
          <span class="score__link">Zobrazit na Firmy.cz <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Všechny recenze -->
  <section class="reviews section section--alt" aria-label="Recenze klientek">
    <div class="container">
      <SectionHeading
        label="Slovy klientek"
        title="Recenze"
      />

      <ul class="reviews__grid" role="list" data-animate>
        {reviews.map(r => (
          <li class="review">
            <span class="review__stars" role="img" aria-label="5 hvězdiček z 5" set:html={stars} />
            <p class="review__text">{r.text}</p>
            <button type="button" class="review__more" aria-expanded="false" hidden>Zobrazit více</button>
            <footer class="review__footer">
              <span class="review__avatar" aria-hidden="true">{r.author.charAt(0)}</span>
              <span class="review__meta">
                <span class="review__author">{r.author}</span>
                <span class="review__source">Recenze na {r.source === 'Google' ? 'Googlu' : 'Seznamu'}</span>
              </span>
            </footer>
          </li>
        ))}
      </ul>

      <p class="reviews__note">
        Recenze jsou převzaté beze změn z&nbsp;<a href={GOOGLE_URL} target="_blank" rel="noopener noreferrer">Map Google</a>
        a&nbsp;<a href={SEZNAM_URL} target="_blank" rel="noopener noreferrer">Firmy.cz</a>, kde je zveřejnily samy klientky.
      </p>

      <div class="reviews__cta">
        <Button href={BOOKING_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
        <Button href={GOOGLE_URL} variant="outline" size="lg" target="_blank" rel="noopener noreferrer">Napsat recenzi na Googlu</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Skóre ── */
  .score__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 320px));
    justify-content: center;
    gap: var(--space-6);
  }

  .score__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .score__card:hover {
    border-color: var(--color-accent-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Loga Googlu a Seznamu ve zlaté JANESKIN; různé výšky vyrovnávají opticky
     stejnou velikost písma obou nápisů. */
  .score__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    margin-bottom: var(--space-2);
    color: var(--color-gold);
  }

  .score__logo :global(svg) {
    display: block;
    width: auto;
  }

  .score__logo--google :global(svg) {
    height: 36px;
  }

  .score__logo--seznam :global(svg) {
    height: 30px;
  }

  .score__value {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    line-height: 1;
    color: var(--color-text);
  }

  .score__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-accent-light);
  }

  .score__stars :global(svg) {
    width: 22px;
    height: 22px;
  }

  .score__count {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .score__link {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }


  /* ── Recenze — mřížka, karty v řádku jsou stejně vysoké ── */
  .reviews__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .review__stars {
    display: inline-flex;
    gap: 1px;
    color: var(--color-accent-light);
  }

  .review__text {
    flex: 1;
    white-space: pre-line;
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
  }

  /* Delší recenze se zkrátí na šest řádků a rozbalí tlačítkem — karty pak
     vycházejí stejně vysoké. Třídu přidává skript, bez něj je text vidět celý. */
  .review__text.is-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  .review__more {
    align-self: flex-start;
    margin-top: calc(-1 * var(--space-2));
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid var(--color-accent-light);
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .review__more:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  .review__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .review__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .review__avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-warm);
    color: var(--color-accent-hover);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review__meta {
    display: flex;
    flex-direction: column;
  }

  .review__author {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .review__source {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  .reviews__note {
    margin-top: var(--space-6);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  .reviews__note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .reviews__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  @media (max-width: 1024px) {
    .reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .score__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .reviews__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .review {
      padding: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .score__card:hover {
      transform: none;
    }
  }
</style>

<script>
  /* Zobrazit více / méně u delších recenzí */
  const cards = document.querySelectorAll<HTMLElement>('.review');
  const measure = () => {
    cards.forEach(card => {
      const text = card.querySelector<HTMLElement>('.review__text');
      const more = card.querySelector<HTMLButtonElement>('.review__more');
      if (!text || !more || more.getAttribute('aria-expanded') === 'true') return;
      text.classList.add('is-clamped');
      more.hidden = text.scrollHeight <= text.clientHeight + 2;
    });
  };
  cards.forEach(card => {
    const text = card.querySelector<HTMLElement>('.review__text');
    const more = card.querySelector<HTMLButtonElement>('.review__more');
    if (!text || !more) return;
    more.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? 'Zobrazit méně' : 'Zobrazit více';
      text.classList.toggle('is-clamped', !open);
    });
  });
  measure();
  window.addEventListener('resize', measure);
  document.fonts?.ready.then(measure);
</script>
