---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import InfoBox from '../components/ui/InfoBox.astro';
import Equipment from '../components/blocks/Equipment.astro';
import FirstVisit from '../components/blocks/FirstVisit.astro';
import Larens from '../components/blocks/Larens.astro';
import PriceList from '../components/blocks/PriceList.astro';
import { pricingData, BOOKING_URL } from '../data/pricing';
---

<Layout
  title="Služby"
  description="Přehled všech kosmetických služeb salonu JANESKIN — ošetření pleti Larens, chemické peelingy, microneedling, masáže, laminace řas a obočí, vizážistika. Dolní Lutyně."
>
  <PageHeader
    title="Služby"
    subtitle="Všechna ošetření přizpůsobuji stavu Vaší pleti a individuálním potřebám. Pracuji výhradně s kosmeceutikou Larens."
    breadcrumb={[{ label: 'Služby', href: '/sluzby' }]}
    image="/images/salon/produkty-larens.jpg"
  />

  <!-- Rychlá navigace -->
  <div class="services-nav">
    <div class="container">
      <ul class="services-nav__list" role="list">
        {pricingData.map(cat => (
          <li>
            <a href={`#${cat.id}`} class="services-nav__link">{cat.category}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <section class="services-section section" aria-label="Nabídka služeb">
    <div class="container">
      <SectionHeading
        label="Nabídka"
        title="Všechna ošetření na jednom místě"
        subtitle="Rozklikněte službu a zobrazí se všechna ošetření v ní, včetně cen, délky a podrobného popisu."
        align="left"
      />

      <div class="services-acc">
        {pricingData.map(cat => (
          <details class="service" id={cat.id} data-animate>
            <summary class="service__head">
              <span class="service__icon" aria-hidden="true" set:html={cat.icon} />

              <span class="service__main">
                <span class="service__title">{cat.category}</span>
                <span class="service__summary">{cat.summary}</span>
              </span>

              <span class="service__meta">
                <Badge text={`od ${cat.priceFrom}`} variant="gold" />
                <Badge text={cat.durationRange} variant="subtle" />
              </span>

              <span class="service__toggle">
                <span class="service__toggle-label">Zobrazit více</span>
                <svg class="service__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>

            <div class="service__body">
              <PriceList category={cat} />
              <div class="service__cta">
                <Button href={BOOKING_URL} variant="primary" size="md" target="_blank" rel="noopener noreferrer">Rezervovat</Button>
                <Button href="/cenik" variant="outline" size="md">Celý ceník</Button>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nutrivi sekce -->
  <section class="nutrivi-strip section section--alt" id="nutrivi" aria-label="Doplňky Nutrivi">
    <div class="container">
      <SectionHeading
        label="Doplňky stravy"
        title="Nutrivi — krása zevnitř"
        subtitle="Prémiové doplňky stravy na bázi přírodních peptidů a rostlinných extraktů. Ideální doplněk ke kosmetické péči."
      />
      <div class="nutrivi-strip__features">
        <InfoBox
          title="Zdraví kloubů a pohybového aparátu"
          text="Podpora přirozené regenerace a pohyblivosti."
          icon={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`}
        />
        <InfoBox
          title="Krása pleti, vlasů a nehtů"
          text="Výživa z hloubky pro viditelné výsledky."
          icon={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`}
        />
        <InfoBox
          title="Imunita a celková regenerace"
          text="Přírodní peptidy a rostlinné extrakty pro vitalitu."
          icon={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`}
        />
      </div>
      <div class="nutrivi-strip__cta">
        <Button href="/kontakt" variant="primary" size="md">Zeptat se na Nutrivi</Button>
      </div>
    </div>
  </section>

  <FirstVisit />
  <Equipment />
  <Larens />
</Layout>

<style>
  /* Rychlá navigace */
  .services-nav {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 72px;
    z-index: calc(var(--z-header) - 1);
  }

  .services-nav__list {
    list-style: none;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .services-nav__list::-webkit-scrollbar { display: none; }

  .services-nav__link {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-soft);
    text-decoration: none;
    padding: var(--space-4) var(--space-5);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .services-nav__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Rozbalovací karty */
  .services-acc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(72px + 56px);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .service:hover {
    border-color: var(--color-accent);
    box-shadow: 0 6px 28px rgba(44, 36, 32, 0.07);
  }

  .service[open] {
    border-color: var(--color-accent);
    box-shadow: 0 6px 28px rgba(44, 36, 32, 0.07);
  }

  .service__head {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    cursor: pointer;
    list-style: none;
  }

  /* Skrytí nativní šipky */
  .service__head::-webkit-details-marker { display: none; }
  .service__head::marker { content: ''; }

  .service__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent-light);
    border-radius: var(--radius-md);
    color: var(--color-accent-hover);
    flex-shrink: 0;
  }

  .service__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .service__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    color: var(--color-text);
    line-height: 1.25;
  }

  .service__summary {
    font-size: var(--text-sm);
    color: var(--color-text-soft);
    line-height: 1.65;
    max-width: 62ch;
  }

  .service__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .service__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent-hover);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .service__chevron {
    transition: transform var(--transition-fast);
  }

  .service[open] .service__chevron {
    transform: rotate(180deg);
  }

  .service__body {
    padding: 0 var(--space-6) var(--space-6);
    border-top: 1px solid var(--color-border);
    margin-top: calc(-1 * var(--space-2));
    padding-top: var(--space-5);
    animation: service-reveal 0.28s ease both;
  }

  @keyframes service-reveal {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .service__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  /* Nutrivi strip */
  .nutrivi-strip__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .nutrivi-strip__cta {
    text-align: center;
  }

  @media (max-width: 900px) {
    .service__head {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'icon main'
        'meta toggle';
      gap: var(--space-4) var(--space-5);
    }
    .service__icon   { grid-area: icon; }
    .service__main   { grid-area: main; }
    .service__meta   { grid-area: meta; justify-content: flex-start; }
    .service__toggle { grid-area: toggle; justify-content: flex-end; }
  }

  @media (max-width: 768px) {
    .nutrivi-strip__features {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .service__head {
      padding: var(--space-5);
    }
    .service__body {
      padding-left: var(--space-5);
      padding-right: var(--space-5);
    }
    .service__title {
      font-size: var(--text-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service__body { animation: none; }
  }
</style>
