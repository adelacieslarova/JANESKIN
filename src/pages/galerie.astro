---
/**
 * Fotogalerie salonu.
 *
 * Tady žijí všechny fotky ze salonu i celé video. Na homepage zůstává
 * jen karusel jako ochutnávka, který sem odkazuje.
 */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { BOOKING_URL } from '../data/pricing';

/**
 * Rozměry fotek čteme při buildu přímo z JPEG hlavičky.
 *
 * Bez nich prohlížeč u líně načítaných obrázků nezná poměr stran, nechá
 * v mřížce prázdné místo a po doskočení fotky obsah poskočí.
 */
function jpegSize(file: string): { w: number; h: number } | null {
  const b = fs.readFileSync(file);
  let i = 2; // za SOI
  while (i < b.length - 9) {
    if (b[i] !== 0xff) { i++; continue; }
    const marker = b[i + 1];
    // SOF0–SOF15 nesou rozměry; DHT/JPG/DAC mezi nimi ne
    if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
      return { h: b.readUInt16BE(i + 5), w: b.readUInt16BE(i + 7) };
    }
    i += 2 + b.readUInt16BE(i + 2);
  }
  return null;
}

const sizeOf = (src: string) => jpegSize(path.join(process.cwd(), 'public', src));

/* Střídáme prostor / ošetření / přípravky / líčení, ať vedle sebe neleží
   dvě podobné fotky. Všechny mají sjednocené vyvážení bílé, aby galerie
   nepůsobila jednou dožluta a jednou dobíla.
   Popisky (alt) jsou psané tak, aby dávaly smysl i ve vyhledávání. */
const photos = [
  { src: '/images/salon/osetreni-pleti-kosmeticky-salon-janeskin.jpg', alt: 'Kosmetické ošetření pleti — Jana Szymiková, salon JANESKIN' },
  { src: '/images/salon/svatebni-uces-drdol-s-ozdobou.jpg', alt: 'Svatební účes — drdol s ozdobou do vlasů' },
  { src: '/images/salon/liceni-a-uces-vizazistika-janeskin.jpg', alt: 'Společenské líčení a účes — vizážistika JANESKIN' },
  { src: '/images/salon/osetreni-maska.jpg', alt: 'Nanášení pleťové masky štětcem při kosmetickém ošetření' },
  { src: '/images/salon/osetreni-masaz-hlavy.jpg', alt: 'Masáž hlavy při kosmetickém ošetření' },
  { src: '/images/salon/aplikace-pletove-masky-kosmeticke-osetreni.jpg', alt: 'Aplikace pleťové masky během kosmetického ošetření' },
  { src: '/images/salon/svatebni-uces-polodrdol-janeskin.jpg', alt: 'Svatební účes — polodrdol s vlnami' },
  { src: '/images/salon/kosmeticky-salon-dolni-lutyne-interier.jpg', alt: 'Interiér kosmetického salonu v Dolní Lutyni' },
  { src: '/images/salon/svatebni-liceni-nevesty-janeskin.jpg', alt: 'Svatební líčení nevěsty v salonu JANESKIN' },
  { src: '/images/salon/produkty-kvetiny.jpg', alt: 'Přípravky Larens a květiny na pultu v salonu' },
  { src: '/images/salon/ultrazvukova-spachtle-cisteni-pleti.jpg', alt: 'Hloubkové čištění pleti ultrazvukovou špachtlí' },
  { src: '/images/salon/mikrojehlickovaci-pero-microneedling-ampule.jpg', alt: 'Mikrojehličkovací pero a ampule s aktivními látkami' },
  { src: '/images/salon/larens-rada.jpg', alt: 'Celá řada kosmeceutik Larens Professional Line' },
  { src: '/images/salon/darkovy-poukaz-kosmeticky-salon-janeskin.jpg', alt: 'Dárkový poukaz na kosmetické ošetření JANESKIN' },
  { src: '/images/salon/profesionalni-liceni-vizazistika-janeskin.jpg', alt: 'Profesionální líčení klientky v salonu JANESKIN' },
  { src: '/images/salon/pdt-lampa-cervene-svetlo-osetreni.jpg', alt: 'Ošetření pleti PDT lampou — červené světlo' },
  { src: '/images/salon/svatebni-uces-s-perlickami.jpg', alt: 'Svatební účes zdobený perličkami' },
  { src: '/images/salon/osetrovaci-lehatko-kosmeticky-salon.jpg', alt: 'Ošetřovací lehátko v kosmetickém salonu JANESKIN' },
  { src: '/images/salon/prirozene-denni-liceni-kosmeticky-salon.jpg', alt: 'Přirozené denní líčení — kosmetický salon JANESKIN' },
  { src: '/images/salon/pristroj-led.jpg', alt: 'LED světelná terapie v kosmetickém salonu' },
  { src: '/images/salon/osetreni-krb.jpg', alt: 'Kosmetické ošetření pleti u krbu' },
  { src: '/images/salon/detail-oci-profesionalni-liceni.jpg', alt: 'Detail očního líčení — profesionální vizážistika' },
  { src: '/images/salon/vozik-s-pripravky-larens.jpg', alt: 'Vozík s přípravky Larens připravený k ošetření' },
  { src: '/images/salon/spolecensky-uces-vlny-janeskin.jpg', alt: 'Společenský účes s vlnami — JANESKIN' },
  { src: '/images/salon/alginatova-maska-kosmeticke-osetreni.jpg', alt: 'Alginátová maska při kosmetickém ošetření' },
  { src: '/images/salon/jana-szymikova-kosmeticka-dolni-lutyne.jpg', alt: 'Jana Szymiková — kosmetička, Dolní Lutyně' },
  { src: '/images/salon/licici-zrcadlo-vizazistika-dolni-lutyne.jpg', alt: 'Líčicí zrcadlo a kosmetika pro vizážistiku' },
  { src: '/images/salon/galvanicka-zehlicka-led-terapie-ionoforeza.jpg', alt: 'Galvanická žehlička s LED terapií v salonu JANESKIN' },
  { src: '/images/salon/produkty-larens.jpg', alt: 'Detail přípravků Larens na zlatém podnosu' },
  { src: '/images/salon/osetreni-roller.jpg', alt: 'Masáž obličeje zlatým rollerem' },
  { src: '/images/salon/obcerstveni-pro-klientky-kosmeticky-salon.jpg', alt: 'Občerstvení pro klientky kosmetického salonu' },
  { src: '/images/salon/salon-lehatko.jpg', alt: 'Ošetřovací lehátko s lampou v salonu JANESKIN' },
  { src: '/images/salon/larens-rucnik-detail-kosmeticky-salon.jpg', alt: 'Detail ručníku Larens v kosmetickém salonu' },
  { src: '/images/salon/jana-konzultace.jpg', alt: 'Konzultace péče o pleť s Janou Szymikovou' },
  { src: '/images/salon/kosmeticky-salon-janeskin-osetrovna.jpg', alt: 'Ošetřovna kosmetického salonu JANESKIN v Dolní Lutyni' },
  { src: '/images/salon/liceni-na-ples-vizazistika-dolni-lutyne.jpg', alt: 'Líčení na ples v líčicím koutku salonu' },
  { src: '/images/salon/osetreni-guasha.jpg', alt: 'Ošetření pleti masážními kameny' },
  { src: '/images/salon/salon-pult.jpg', alt: 'Pult s přípravky Larens v kosmetickém salonu' },
  { src: '/images/salon/salon-para.jpg', alt: 'Ošetření pleti párou v kosmetickém salonu' },
  { src: '/images/salon/pripravky-larens-vozik-salon.jpg', alt: 'Police a vozík s přípravky Larens v salonu' },
  { src: '/images/salon/osetreni-masaz.jpg', alt: 'Masáž obličeje, krku a dekoltu' },
  { src: '/images/salon/jana-portret.jpg', alt: 'Jana Szymiková v kosmetickém salonu JANESKIN' },
];
---

<Layout
  title="Fotogalerie"
  description="Fotogalerie kosmetického salonu JANESKIN v Dolní Lutyni — interiér salonu, ošetření pleti, přístroje a kosmeceutika Larens. Jana Szymiková."
>
  <PageHeader
    label="Galerie"
    title="Podívejte se ke mně"
    subtitle="Prostor, přístroje i ošetření tak, jak to u mě v salonu vypadá."
    breadcrumb={[{ label: 'Galerie', href: '/galerie' }]}
    image="/images/salon/liceni-zrcadlo-pruh.jpg"
    imageFit="contain"
    fullBleed
  />

  <!-- Video -->
  <section class="gal-video section" aria-label="Video ze salonu">
    <div class="container">
      <div class="gal-video__frame" data-animate>
        <video
          id="salon-video"
          class="gal-video__player"
          src="/video/salon.mp4"
          width="848"
          height="480"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          aria-label="Video z kosmetického salonu JANESKIN"
        ></video>
      </div>
    </div>
  </section>

  <!-- Fotky -->
  <section class="gal-photos section section--alt" aria-label="Fotografie ze salonu">
    <div class="container">
      <SectionHeading
        label="Fotografie"
        title="Ze salonu"
      />

      <ul class="gal-grid" role="list" data-animate>
        {photos.map((photo, i) => {
          const size = sizeOf(photo.src);
          const wide = size ? size.w > size.h : false;
          return (
            <li class:list={['gal-grid__item', wide && 'gal-grid__item--wide']}>
              <a href={photo.src} class="gal-grid__link" target="_blank" rel="noopener noreferrer">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  class="gal-grid__img"
                  loading={i < 8 ? 'eager' : 'lazy'}
                  decoding="async"
                  width={size?.w}
                  height={size?.h}
                />
              </a>
            </li>
          );
        })}
      </ul>

      <div class="gal-photos__cta">
        <Button href={BOOKING_URL} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">Objednat se</Button>
        <Button href="/sluzby" variant="outline" size="lg">Prohlédnout služby</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Video je natočené na výšku (480×848) — rámeček drží stejný poměr,
     takže se nic neořezává ani nezbývají prázdné pruhy. */
  .gal-video__frame {
    width: min(440px, 100%);
    margin: 0 auto;
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-dark);
    box-shadow: var(--shadow-lg);
  }

  .gal-video__player {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 480 / 848;
    object-fit: cover;
  }

  /* Pravidelná mřížka se stejně vysokými řadami, aby galerie dole seděla.
     Fotka na výšku zabere jedno políčko 3 : 4, fotka na šířku dvě vedle sebe
     (vyjde to zhruba na 3 : 2, takže se skoro neořezává). „dense“ dosype
     díry, které by široká fotka na konci řady nechala.
     Pořadí fotek v poli výše je vyladěné tak, aby při 4, 3 i 2 sloupcích
     nezbyla dole díra (36 na výšku + 6 na šířku = 48 políček). Když fotky
     přidáváš nebo ubíráš, drž počet políček dělitelný 12. */
  .gal-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    grid-auto-flow: row dense;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .gal-grid__item {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-bg-warm);
    aspect-ratio: 3 / 4;
  }

  .gal-grid__item--wide {
    grid-column: span 2;
    aspect-ratio: auto;
  }

  .gal-grid__link {
    position: absolute;
    inset: 0;
    display: block;
  }

  .gal-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .gal-grid__item:hover .gal-grid__img {
    transform: scale(1.04);
  }

  .gal-photos__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  @media (max-width: 1024px) {
    .gal-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .gal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal-grid__item:hover .gal-grid__img {
      transform: none;
    }
  }
</style>

<script>
  /* Kdo má vypnuté animace, tomu se video nespustí samo */
  const video = document.getElementById('salon-video') as HTMLVideoElement | null;
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.autoplay = false;
    video.loop = false;
    video.pause();
  }
</script>
